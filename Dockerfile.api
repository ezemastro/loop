# ===== ETAPA 0: Desarrollo (TS con hot reload) =====
FROM node:22-slim AS development
WORKDIR /app

# Instalamos dependencias raíz y del API para monorepo
COPY package*.json ./
COPY server/api/package*.json ./server/api/
RUN npm ci
WORKDIR /app/server/api
RUN npm ci --include=dev

# Copiamos código del API, tipos compartidos y migraciones (el runner `npm run migrate` las busca en ../migrations)
WORKDIR /app
COPY shared ./shared
COPY server/api ./server/api
COPY server/migrations ./server/migrations

WORKDIR /app/server/api
EXPOSE 3000
CMD ["sh", "-c", "npm ci --include=dev && npm run dev"]

# ===== ETAPA 1: Build (Compilación de TS a JS) =====
FROM node:22-slim AS build
WORKDIR /app

# Copiamos archivos de configuración
COPY package*.json ./
COPY server/api/package*.json ./server/api/
# Copiamos AMBOS tsconfig
COPY server/api/tsconfig*.json ./server/api/

RUN npm ci
WORKDIR /app/server/api
RUN npm ci

# Copiamos shared y api
WORKDIR /app
COPY shared ./shared
COPY server/api ./server/api

# COMPILACIÓN usando el config de producción
WORKDIR /app/server/api

RUN npx tsc -p tsconfig.prod.json

RUN find dist -name "index.js"

# ===== ETAPA 2: Producción =====
FROM node:22-alpine AS production

# sec-hardening-api (SEC-01, task 7.10): sin esto, un contenedor arrancado sin pasar NODE_ENV
# explícitamente (por ejemplo, `docker run` directo, sin compose) cae en la rama permisiva de
# `env.ts` — secretos dev-sentinel, CORS abierto a cualquier origen local, `assertDbHardening()`
# no bloqueante. `compose.yml` ya fija `NODE_ENV=production` en su propio `environment:`, que
# sigue ganando por precedencia; esto es la defensa en profundidad para cuando la imagen corre
# fuera de ese compose.
ENV NODE_ENV=production
WORKDIR /app

# Instalamos solo dependencias de producción
COPY server/api/package*.json ./
RUN npm ci --omit=dev

# Copiamos el JS compilado
COPY --from=build /app/server/api/dist ./dist

# Si existe la ruta larga, movemos TODO su contenido a la raíz de /app/dist
RUN if [ -d "./dist/server/api/src" ]; then \
        cp -r ./dist/server/api/src/* ./dist/ && \
        rm -rf ./dist/server; \
    fi

# Migraciones SQL: son datos, no salida compilada. El runner (dist/scripts/migrate.js) las lee
# desde MIGRATIONS_DIR=/app/migrations (ver compose.yml, servicio `migrate`).
COPY server/migrations ./migrations

RUN mkdir -p uploads
EXPOSE 3000

CMD ["node", "dist/index.js"]