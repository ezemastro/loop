FROM node:22-slim
WORKDIR /app
COPY client/package*.json ./client/
WORKDIR /app/client
RUN npm install
WORKDIR /app
# `client/demo/` importa el dataset de `shared/demo-data`: sin esta copia Metro no lo resuelve.
COPY shared ./shared
COPY client ./client
WORKDIR /app/client
EXPOSE 8081
CMD ["sh", "-c", "npm install && npx expo start --web --port 8081"]
