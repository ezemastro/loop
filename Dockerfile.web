# Etapa de compilación
FROM node:22-slim AS build
WORKDIR /app

# 1. Copiamos los package.json
COPY package*.json ./
COPY client/package*.json ./client/

# 2. Instalamos dependencias
RUN npm ci
WORKDIR /app/client
RUN npm ci

# 3. Copiamos el código ANTES del export
WORKDIR /app
COPY shared ./shared
COPY client ./client

# 4. Declaramos ARG y ENV para que Expo las vea al compilar
ARG EXPO_PUBLIC_API_URL
ARG EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID
ENV EXPO_PUBLIC_API_URL=$EXPO_PUBLIC_API_URL
ENV EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID=$EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID

# 5. Compilamos la web
WORKDIR /app/client
RUN npx expo export --platform web

# Etapa de producción
FROM node:22-slim
WORKDIR /app
RUN npm install -g serve

# OJO: Metro exporta a la carpeta 'dist', no a 'web-build'
COPY --from=build /app/client/dist ./dist

# Inyectar metatags PWA en el HTML estático
RUN sed -i 's|<head>|<head><link rel="manifest" href="/manifest.json"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="apple-mobile-web-app-title" content="Loop"><meta name="apple-mobile-web-app-status-bar-style" content="default"><link rel="apple-touch-icon" href="/icons/apple-touch-icon.png"><meta name="theme-color" content="#FF5900">|' dist/index.html
RUN sed -i 's|lang="en"|lang="es"|' dist/index.html

EXPOSE 3000
CMD ["serve", "-s", "dist", "-l", "3000"]