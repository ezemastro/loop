# Variables necesarias para "npm run docker:build" (bash scripts/build-images.sh).
# Copiá este archivo a .build.env y completá los valores reales:
#   cp .build.env.example .build.env
#
# .build.env NO se commitea (está en .gitignore): son valores de build de tu
# entorno local, no configuración del repo. Este .example sí se versiona como
# referencia de qué variables existen y qué significan.
#
# Se hornean en el bundle estático de cada imagen al momento del build (Expo /
# Vite las inlinean en el JS compilado) — si cambian, hay que rebuildear y
# republicar la imagen correspondiente, no alcanza con reiniciar el contenedor.

# URL pública de la API que va a consumir el cliente web (Expo) una vez compilado.
WEB_API_BASE_URL=https://api.tuloop.com

# Client ID de OAuth de Google usado para el login en el cliente web.
WEB_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# URL pública de la API que va a consumir el panel admin (Vite) una vez compilado.
ADMIN_API_BASE_URL=https://api.tuloop.com

# Client ID de OAuth de Google usado para el login en el panel admin.
ADMIN_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
