# Template para entorno Loop
NODE_ENV=
EXPO_PUBLIC_API_URL=
BASE_URL=

# Dueño de las tablas. En la imagen oficial de Postgres este usuario es SUPERUSER, y los
# superusuarios ignoran Row-Level Security: por eso la API NO se conecta con él. Se usa solo para
# migraciones y backups.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
PGHOST=

# Roles con los que se conecta la API. Los crea la migración 0007 a partir de estos valores.
#   DB_APP_USER      → sujeto a RLS, atiende todo el tráfico de usuarios
#   DB_UNSCOPED_USER → con BYPASSRLS, solo login y panel de admin
# Usá contraseñas distintas de la de POSTGRES_PASSWORD.
DB_APP_USER=loop_app
DB_APP_PASSWORD=
DB_UNSCOPED_USER=loop_app_unscoped
DB_UNSCOPED_PASSWORD=

# URL pública de la app, usada para armar los links de invitación
APP_BASE_URL=

API_PORT=3000
SALT_ROUNDS=10
JWT_SECRET=
ADMIN_PASS_TOKEN=

# Google OAuth
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_CLIENT_SECRET=
EXPO_PUBLIC_WEB_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_IOS_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_ANDROID_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_SECRET=
IOS_GOOGLE_CLIENT_ID=
ANDROID_GOOGLE_CLIENT_ID=

# Email de admin autorizado por defecto (siempre puede registrarse/loguearse como admin)
AUTHORIZED_ADMIN_EMAIL=

# Admin Client (required in build time)
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=
# Email (Resend) - si falta, el mail de verificación no sale y el link queda en el log del api
RESEND_API_KEY=
# Exigir verificación de email en el registro. Por defecto se deduce de RESEND_API_KEY;
# ponela en true para exigirla igual sin proveedor de mail (el link queda en el log del api).
REQUIRE_EMAIL_VERIFICATION=
