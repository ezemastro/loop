{
  "name": "Node.js",
  "image": "node:24-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/postfinance/devcontainer-features/opencode:1": {}
  },

  // 👇 Esto monta tu config global de opencode del host dentro del container
  "mounts": [
    "source=${localEnv:HOME}/.config/opencode,target=/home/node/.config/opencode,type=bind"
  ],

  // 👇 Si tenés skills externas de Claude Code, también las montás
  // "mounts": [
  //   "source=${localEnv:HOME}/.config/opencode,target=/home/node/.config/opencode,type=bind",
  //   "source=${localEnv:HOME}/.claude/skills,target=/home/node/.claude/skills,type=bind"
  // ],

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    }
  }
}
